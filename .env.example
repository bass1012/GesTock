# ──────────────────────────────────────────────────────────────────────────────
# .env.example — Fichier de configuration de DÉVELOPPEMENT LOCAL
#
# ⚠️  NE JAMAIS committer .env avec de vraies valeurs en production.
# ⚠️  Ce fichier est un modèle — toutes les valeurs sont FICTIVES.
#
# Usage :
#   cp .env.example .env
#   # Modifiez les valeurs selon votre environnement local
#   docker compose up -d
#
# Convention :
#   - Valeurs DEV    → suffixe "_DEV_PLACEHOLDER" ou commentaire explicite
#   - Valeurs PROD   → voir .env.prod.example (secrets réels requis)
# ──────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL (dev local via Docker) ─────────────────────────────────────────
# Ces variables alimentent docker-compose.yml ET le backend
POSTGRES_DEV_USER=gestock
POSTGRES_DEV_PASSWORD=local-dev-db-placeholder-change-me
POSTGRES_DEV_DB=gestock_db

DATABASE_URL="postgresql://gestock:local-dev-db-placeholder-change-me@localhost:5432/gestock_db?schema=public"

# ── Redis (dev local via Docker) ──────────────────────────────────────────────
# Laisser vide = pas d'auth Redis en dev (acceptable localement)
REDIS_DEV_PASSWORD=
REDIS_URL="redis://localhost:6379"

# ── JWT ────────────────────────────────────────────────────────────────────────
# Générer en prod avec : openssl rand -hex 64
# ⚠️  Ces valeurs sont UNIQUEMENT pour le développement local
JWT_SECRET="dev-only-jwt-secret-do-not-use-in-production-aaa111bbb222"
JWT_REFRESH_SECRET="dev-only-refresh-secret-do-not-use-in-production-ccc333ddd444"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# ── Serveur ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV="development"
FRONTEND_URL="http://localhost:5173"

# ── Chiffrement (Phase 7 — Sécurité) ──────────────────────────────────────────
# Générer en prod avec : openssl rand -base64 32
# ⚠️  Laisser vide en dev si la fonctionnalité n'est pas testée
ENCRYPTION_KEY=""

# ── Backup chiffré ─────────────────────────────────────────────────────────────
# Générer avec : openssl rand -hex 32
# ⚠️  Requis uniquement si vous testez le chiffrement des backups en local
BACKUP_ENCRYPTION_KEY=""

# ── Alertes backup ─────────────────────────────────────────────────────────────
ALERT_EMAIL=""
SLACK_WEBHOOK_URL=""

# ── Super Admin ─────────────────────────────────────────────────────────────────
# Le Super Admin utilise désormais email + mot de passe + TOTP 2FA (JWT signé).
# Plus de token statique. Lancer `npm -w backend run db:seed` pour créer le compte.
# SUPER_ADMIN_SECRET est obsolète et n'est plus utilisé.

# ── Stripe (Phase 3) ───────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ── S3 / Backups hors-site ─────────────────────────────────────────────────────
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
# Format rclone : "s3:my-bucket/backups" ou "drive:backups/gestock"
BACKUP_S3_DEST=""

# ── Email (notifications) ──────────────────────────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@gestock.app"

# ── Rate limiting ──────────────────────────────────────────────────────────────
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5

# ── Frontend ────────────────────────────────────────────────────────────────────
VITE_INACTIVITY_TIMEOUT_MINUTES=120

# ── Sentry (Phase 10 — Monitoring) ────────────────────────────────────────────
# Obtenir le DSN sur https://sentry.io → Project Settings → Client Keys
SENTRY_DSN=""
VITE_SENTRY_DSN=""
