{
  "name": "gestock-saas",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm -w frontend run dev",
    "dev:backend": "npm -w backend run dev",
    "build": "npm -w frontend run build && npm -w backend run build",
    "lint": "npm -w frontend run lint && npm -w backend run lint",
    "lint:fix": "npm -w frontend run lint -- --fix && npm -w backend run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "node -e \"if(process.env.NODE_ENV!=='production' && process.env.CI!=='true'){require('child_process').execSync('husky',{stdio:'inherit'})}\"",
    "test:related:backend": "npm -w backend run test -- --findRelatedTests --passWithNoTests --forceExit",
    "test:related:frontend": "npm -w frontend run test -- --passWithNoTests"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.30.0",
    "@typescript-eslint/parser": "^8.30.0",
    "concurrently": "^9.0.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-sonarjs": "^0.25.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "prettier": "^3.5.3"
  },
  "lint-staged": {
    "backend/src/**/*.{ts,js}": [
      "eslint --fix",
      "bash -c 'npm run test:related:backend -- $0'"
    ],
    "frontend/src/**/*.{ts,tsx}": [
      "eslint --fix",
      "bash -c 'npm run test:related:frontend'"
    ],
    "*.{json,md,css,scss,yml,yaml}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "lru-cache": "10.2.0"
  }
}
