# --- DATABASE ---
DB_USER=gestock
DB_PASSWORD=your_strong_password_here
DB_NAME=gestock_db

# --- SECRETS ---
# Generate with: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here
ENCRYPTION_KEY=your_encryption_key_here (32 chars)

# --- APP ---
NODE_ENV=production
FRONTEND_URL=https://gestock.allsite.cloud

# --- INFRA ---
# These are used by Docker Compose
# DATABASE_URL and REDIS_URL are handled internally by docker-compose
