# --- DATABASE ---
DB_USER=gestock
DB_PASSWORD=your_strong_password_here
DB_NAME=gestock_db

# --- REDIS ---
REDIS_PASSWORD=your_redis_password_here

# --- SECRETS ---
# Generate with: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here
ENCRYPTION_KEY=your_encryption_key_here_32chars
ENCRYPTION_MASTER_KEY=your_encryption_master_key_here
BACKUP_ENCRYPTION_KEY=your_backup_encryption_hex_key_here

# --- SUPER ADMIN ---
SUPER_ADMIN_SECRET=your_super_admin_secret_here

# --- STRIPE ---
STRIPE_SECRET_KEY=sk_live_your_stripe_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# --- APP ---
NODE_ENV=production
FRONTEND_URL=https://gestock.allsite.cloud

# --- MONITORING ---
SENTRY_DSN=https://your_dsn@sentry.io/your_project
VITE_SENTRY_DSN=https://your_dsn@sentry.io/your_project

# --- FRONTEND BUILD ---
VITE_INACTIVITY_TIMEOUT_MINUTES=120

# --- INFRA ---
# DATABASE_URL and REDIS_URL are constructed internally by docker-compose
# using DB_* and REDIS_* values above — no need to set them manually
